<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Rustino.NET.Reactive</PackageId>
    <Description>System.Reactive extensions for Rustino.NET window events.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rustino.NET/Rustino.NET.csproj" />
    <PackageReference Include="System.Reactive" Version="6.*" />
  </ItemGroup>

</Project>
