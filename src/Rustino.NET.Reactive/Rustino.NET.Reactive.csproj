<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Rustino.NET.Reactive</PackageId>
    <Description>System.Reactive extensions for Rustino.NET window events.</Description>
    <Authors>Ivy Interactive</Authors>
    <Company>Ivy Interactive</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Ivy-Interactive/Rustino</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Ivy-Interactive/Rustino</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Rustino.NET/Rustino.NET.csproj" />
    <PackageReference Include="System.Reactive" Version="6.*" />
  </ItemGroup>

</Project>
