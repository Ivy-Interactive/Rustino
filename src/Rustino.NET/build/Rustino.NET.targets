<Project>
  <Target Name="CopyRustinoNativeMacOS" AfterTargets="Build;Publish">
    <PropertyGroup>
      <RustinoNativePath Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\librustino_native.dylib')">$(MSBuildThisFileDirectory)..\runtimes\osx-arm64\native\librustino_native.dylib</RustinoNativePath>
      <RustinoNativePath Condition="'$(RustinoNativePath)' == '' And Exists('$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\librustino_native.dylib')">$(MSBuildThisFileDirectory)..\runtimes\osx-x64\native\librustino_native.dylib</RustinoNativePath>
      <DestinationPath Condition="'$(PublishDir)' != ''">$(PublishDir)</DestinationPath>
      <DestinationPath Condition="'$(DestinationPath)' == ''">$(OutputPath)</DestinationPath>
    </PropertyGroup>
    <Copy SourceFiles="$(RustinoNativePath)" DestinationFolder="$(DestinationPath)" Condition="'$(RustinoNativePath)' != ''" />
  </Target>
  <Target Name="CopyRustinoNativeWindows" AfterTargets="Build;Publish">
    <PropertyGroup>
      <RustinoNativePathWin Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\win-arm64\native\rustino_native.dll')">$(MSBuildThisFileDirectory)..\runtimes\win-arm64\native\rustino_native.dll</RustinoNativePathWin>
      <RustinoNativePathWin Condition="'$(RustinoNativePathWin)' == '' And Exists('$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\rustino_native.dll')">$(MSBuildThisFileDirectory)..\runtimes\win-x64\native\rustino_native.dll</RustinoNativePathWin>
      <DestinationPathWin Condition="'$(PublishDir)' != ''">$(PublishDir)</DestinationPathWin>
      <DestinationPathWin Condition="'$(DestinationPathWin)' == ''">$(OutputPath)</DestinationPathWin>
    </PropertyGroup>
    <Copy SourceFiles="$(RustinoNativePathWin)" DestinationFolder="$(DestinationPathWin)" Condition="'$(RustinoNativePathWin)' != ''" />
  </Target>
  <Target Name="CopyRustinoNativeLinux" AfterTargets="Build;Publish">
    <PropertyGroup>
      <RustinoNativePathLinux Condition="Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-arm64\native\librustino_native.so')">$(MSBuildThisFileDirectory)..\runtimes\linux-arm64\native\librustino_native.so</RustinoNativePathLinux>
      <RustinoNativePathLinux Condition="'$(RustinoNativePathLinux)' == '' And Exists('$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\librustino_native.so')">$(MSBuildThisFileDirectory)..\runtimes\linux-x64\native\librustino_native.so</RustinoNativePathLinux>
      <DestinationPathLinux Condition="'$(PublishDir)' != ''">$(PublishDir)</DestinationPathLinux>
      <DestinationPathLinux Condition="'$(DestinationPathLinux)' == ''">$(OutputPath)</DestinationPathLinux>
    </PropertyGroup>
    <Copy SourceFiles="$(RustinoNativePathLinux)" DestinationFolder="$(DestinationPathLinux)" Condition="'$(RustinoNativePathLinux)' != ''" />
  </Target>
</Project>
