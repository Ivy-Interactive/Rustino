<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Rustino.NET</PackageId>
    <Description>Cross-platform native webview windows powered by Rust (wry/tao). Drop-in replacement for Photino.NET.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <!-- Native library: local dev (current platform) -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="../Rustino.Native/target/release/rustino_native.dll"
             CopyToOutputDirectory="PreserveNewest"
             Link="rustino_native.dll"
             Condition="Exists('../Rustino.Native/target/release/rustino_native.dll')" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="../Rustino.Native/target/release/librustino_native.dylib"
             CopyToOutputDirectory="PreserveNewest"
             Link="librustino_native.dylib"
             Condition="Exists('../Rustino.Native/target/release/librustino_native.dylib')" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="../Rustino.Native/target/release/librustino_native.so"
             CopyToOutputDirectory="PreserveNewest"
             Link="librustino_native.so"
             Condition="Exists('../Rustino.Native/target/release/librustino_native.so')" />
  </ItemGroup>

  <!-- NuGet packaging -->
  <ItemGroup>
    <None Include="build/Rustino.NET.targets" Pack="true" PackagePath="build/Rustino.NET.targets" />
    <None Include="build/Rustino.NET.targets" Pack="true" PackagePath="buildTransitive/Rustino.NET.targets" />
    <None Include="../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
